generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id           Int      @id @default(autoincrement())
  nombre       String
  presentacion String
  precio       Decimal  @db.Decimal(10, 2)
  costo        Decimal? @db.Decimal(10, 2)
  precio_mayor Decimal? @db.Decimal(10, 2)
  precio_dist  Decimal? @db.Decimal(10, 2)
  stock        Int      @default(0)
  categoria    String?
  fecha_act    DateTime @default(now())

  @@unique([nombre, presentacion], name: "nombre_presentacion")
}